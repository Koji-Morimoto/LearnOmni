"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "parallelogram_arm" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </parallelogram_arm/Physics/root_joint>,
        </parallelogram_arm/Physics/joint_crank>,
        </parallelogram_arm/Physics/joint_rocker>,
        </parallelogram_arm/Physics/joint_coupler>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </parallelogram_arm/Geometry/base_link>,
        </parallelogram_arm/Geometry/base_link/link_crank>,
        </parallelogram_arm/Geometry/base_link/link_crank/link_coupler>,
        </parallelogram_arm/Geometry/base_link/link_rocker>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link_crank" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_coupler" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "link_rocker" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_crank" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_coupler" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rocker" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

